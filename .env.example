# ClauseBridge runs without any of these locally (SQLite, no AI). Never commit real values.

# Ant Ling (server only, never NEXT_PUBLIC_). Enables term suggestions and report wording.
# Create the key at chat.ant-ling.com/open.
ANT_LING_API_KEY=
# Optional overrides. Defaults: https://api.ant-ling.com/v1 and Ling-3.2-flash.
ANT_LING_BASE_URL=
ANT_LING_MODEL=

# Required on Vercel: a PostgreSQL connection string (for example from Neon).
# Leave unset locally to use a private SQLite file in .clausebridge-data/.
DATABASE_URL=

# Optional local SQLite directory.
CLAUSEBRIDGE_DATA_DIR=
